# syntax=docker/dockerfile:1
# Stage 1: Build ovnkube binary from modified source
FROM golang:1.25 AS builder

WORKDIR /build
COPY go-controller/ go-controller/

WORKDIR /build/go-controller
RUN --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -mod=vendor -ldflags="-s -w" -o /ovnkube ./cmd/ovnkube/

# Stage 2: Use existing OVN-K image and replace ovnkube binary
FROM ghcr.io/ovn-kubernetes/ovn-kubernetes/ovn-kube-ubuntu:release-1.1

COPY --from=builder /ovnkube /usr/bin/ovnkube

# HackCTF fix: patch ovnkube.sh so that an empty OVN_GATEWAY_MODE
# (which represents GatewayModeDisabled) is NOT silently rewritten
# to "shared" by the shell default in line 179. With the default the
# ovnkube binary always boots into GatewayModeShared, recreating
# breth1 on every node even when we want gateway mode disabled.
RUN sed -i 's|ovn_gateway_mode=${OVN_GATEWAY_MODE:-"shared"}|ovn_gateway_mode=${OVN_GATEWAY_MODE}|' /root/ovnkube.sh && \
    grep -n "ovn_gateway_mode=" /root/ovnkube.sh | head -3

LABEL org.opencontainers.image.source="https://github.com/HackCTF/ovn-kubernetes" \
      org.opencontainers.image.description="OVN-Kubernetes with HackCTF fix: cleanupStaleGatewayBridges on gatewayMode=disabled + respect empty OVN_GATEWAY_MODE" \
      org.opencontainers.image.version="release-1.1-hackctf-fix-v3"